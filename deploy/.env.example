# Настройки Sobesnik. Скопируйте в корень репозитория и впишите токен бота:
#
#     cp deploy/.env.example .env
#
# Для бота нужна одна строка — TELEGRAM_BOT_TOKEN. Без Telegram её можно оставить пустой: работает
# веб-кабинет http://127.0.0.1:8080 → «Войти без Telegram». Всё остальное закомментировано: так
# работают значения по умолчанию (они показаны после «=»). Чтобы поменять настройку — уберите «#».
# После правки .env: docker compose up -d (контейнеры с новыми настройками пересоздадутся сами).
# Файл .env в git не попадает: токены и ключи остаются только у вас.

# === 1. Обязательно ===========================================================

# Токен бота от @BotFather: напишите ему /newbot, придумайте имя — он пришлёт строку вида
# 123456789:AAE...  Вставьте её сюда целиком, без кавычек и пробелов. Пусто — бот не запускается,
# веб-кабинет работает.
TELEGRAM_BOT_TOKEN=

# === 2. Желательно ============================================================

# Кто может пользоваться ботом: telegram_id через запятую (свой id подскажет @userinfobot,
# а ещё бот сам покажет id человеку, которому отказал). Пусто — бот отвечает любому, кто его найдёт.
BOT_ALLOWED_IDS=

# Порт API на этом компьютере: http://localhost:8000/docs. Наружу (в локальную сеть) не открыт.
# Если 8000 занят другой программой — поставьте другой, например 8001. Бот от порта не зависит.
# API_PORT=8000

# Порт веб-кабинета на этом компьютере: http://127.0.0.1:8080. Тоже только для этого компьютера.
# Поменяли — поменяйте и WEB_PUBLIC_URL ниже, чтобы ссылка из бота вела куда надо.
# WEB_PORT=8080

# === 3. Где работает модель (профиль) ==========================================
# По умолчанию — профиль mac: Ollama установлена на этом компьютере, Sobesnik ходит в неё из Docker.
# Нужно один раз скачать модель: ollama pull qwen3.5:4b
# Для двух других профилей раскомментируйте ОДИН блок ниже.

# --- Профиль gpu: Linux-сервер с видеокартой NVIDIA (нужен NVIDIA Container Toolkit).
# Ollama и распознавание речи запускаются в контейнерах на GPU, модель скачается сама при первом запуске.
# COMPOSE_FILE=compose.yaml:deploy/compose.gpu.yaml

# --- Профиль cloud: любая модель с OpenAI-совместимым API (облако или свой сервер).
# Распознавание речи остаётся на этом компьютере.
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=model-name

# --- То же через OpenAI-совместимый API самой Ollama (проверка «cloud» без облачного ключа).
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_REASONING_EFFORT=none

# === 4. Языковая модель (LLM) ================================================

# Провайдер: ollama | openai_compatible | fake (fake — только для тестов, отвечает заготовками)
# LLM_PROVIDER=ollama
# Адрес модели. host.docker.internal — это ваш компьютер, если смотреть из Docker.
# LLM_BASE_URL=http://host.docker.internal:11434
# Ключ — только для openai_compatible
# LLM_API_KEY=
# Модель. Для Ollama должна быть скачана: ollama pull <имя>. qwen3.5:4b — лучшая из проверенных
# на 16 ГБ (research/README.md); запасная — gemma3:4b.
# LLM_MODEL=qwen3.5:4b
# Сколько секунд ждать ответа модели на один запрос
# LLM_TIMEOUT_S=120
# Размер контекста Ollama: длинная вакансия не влезает в стандартный
# LLM_NUM_CTX=16384
# Формат ответа для openai_compatible: json_schema | json_object (если endpoint не понимает json_schema)
# LLM_STRUCTURED=json_schema
# Только для openai_compatible: none — выключить «рассуждения» модели (нужно для /v1 Ollama, иначе
# qwen3.5 долго рассуждает и обрезает ответ). Пусто — параметр не отправляется.
# LLM_REASONING_EFFORT=
# Сколько раз переспросить модель, если её ответ не прошёл проверку формата
# LLM_MAX_RETRIES=2

# Отдельные модели для двух задач: gen — разбор вакансии и вопросы, eval — оценка ответов.
# Пусто — берётся общее значение LLM_* выше.
# LLM_GEN_PROVIDER=
# LLM_GEN_BASE_URL=
# LLM_GEN_API_KEY=
# LLM_GEN_MODEL=
# LLM_EVAL_PROVIDER=
# LLM_EVAL_BASE_URL=
# LLM_EVAL_API_KEY=
# LLM_EVAL_MODEL=

# === 5. Голосовые ответы =====================================================

# Распознавание речи: faster_whisper | fake
# ASR_PROVIDER=faster_whisper
# Модель whisper: tiny | base | small | medium | large-v3 | turbo. Скачивается при старте воркера
# в том asr-models (small — около 0,5 ГБ, минута речи — около 10 с на Маке). Больше — точнее и медленнее.
# ASR_MODEL=small
# Язык речи; auto — определять самому
# ASR_LANGUAGE=ru
# Где считать: cpu | cuda | auto. В профиле gpu ставится cuda автоматически.
# ASR_DEVICE=cpu
# Точность вычислений: int8 — быстрее всего на CPU, float16 — для GPU
# ASR_COMPUTE_TYPE=int8
# Ширина поиска при распознавании: больше — чуть точнее и медленнее
# ASR_BEAM_SIZE=5
# Потоков CPU для распознавания; 0 — по числу ядер
# ASR_CPU_THREADS=0
# Сколько раз пробовать распознать при сбое (вместе с первой попыткой)
# ASR_MAX_TRIES=4
# Через сколько дней запись удаляется сама (расшифровка и оценка остаются). /forget — сразу.
# AUDIO_TTL_DAYS=30
# Лимиты на одну запись: размер в байтах (25 МБ) и длительность в секундах (5 минут)
# AUDIO_MAX_BYTES=26214400
# AUDIO_MAX_SECONDS=300

# === 6. Бот, веб-кабинет и доступ к API =======================================

# Вопросов в тренировке по умолчанию (/train 10 — другое число, от 3 до 15)
# BOT_QUESTIONS=5
# Сервисный токен: бот, веб-кабинет и скрипты research/ шлют его в заголовке Authorization: Bearer.
# Пусто — API отвечает любому, кто достучится до порта (по умолчанию — только с этого компьютера).
# Задайте любую длинную случайную строку, если открываете порт наружу.
# API_SERVICE_TOKEN=
# Админ-токен для /api/v1/admin/* (датасеты, прогоны, выгрузка CSV). Пусто — эти адреса выключены.
# ADMIN_TOKEN=

# Адрес веб-кабинета в ссылке входа, которую присылает бот по /web
# WEB_PUBLIC_URL=http://127.0.0.1:8080
# Кнопка «Войти без Telegram». Пароля у неё нет: веб открыт только на этом компьютере. Если открываете
# порт веба наружу — поставьте false.
# WEB_LOCAL_LOGIN=true
# Через сколько дней без заходов веб-кабинет попросит войти снова
# WEB_SESSION_DAYS=30

# === 7. Прогресс по темам (007 §5) ============================================

# Меньше попыток по теме — «мало данных»: одна оценка ошибается на ±20
# PROGRESS_MIN_ATTEMPTS=2
# Среднее трёх последних попыток ниже этого — тема слабая
# PROGRESS_WEAK_AVG=60
# «Мало данных» с баллом ниже этого — пометка «похоже, стоит повторить» в прогрессе.
# Когда повторять тему, решает SM-2: провал — сразу, хороший ответ — через сутки, неделю и реже (011 §5)
# PROGRESS_LOW_SCORE=60

# Проверка ключевых пунктов эталона моделью в фоне: сомнения видны в подробном разборе.
# Выключена: на qwen3.5:4b находит половину ошибок и тревожится зря в 4 вопросах из 10 (011 «Итоги»).
# KEY_POINTS_CHECK=false

# === 8. Вакансия по ссылке ====================================================

# Сколько секунд ждать страницу вакансии
# FETCH_TIMEOUT_S=10
# VPN в режиме fake-IP (Clash, sing-box…) выдаёт сайтам служебные адреса. 198.18.0.0/15 считается
# внешним всегда; если ссылки всё равно не открываются, а бот пишет про VPN — добавьте сюда подсети
# через запятую, например 240.0.0.0/4:
# FETCH_ALLOW_NETWORKS=
# Разрешить ссылки на внутренние адреса (localhost, 10.x, 192.168.x) — только для экспериментов
# FETCH_ALLOW_PRIVATE=false

# === 9. Служебное: трогать не нужно ===========================================

# Вторая копия Sobesnik на той же машине: своё имя — свои контейнеры и данные (и другой API_PORT)
# COMPOSE_PROJECT_NAME=sobesnik
# Сервисы из compose: база, очередь, хранилище аудио
# DATABASE_URL=postgresql+asyncpg://sobesnik:sobesnik@postgres:5432/sobesnik
# REDIS_URL=redis://redis:6379/0
# S3_ENDPOINT_URL=http://s3:9000
# Ключи хранилища аудио — они же учётная запись сервиса s3
# S3_ACCESS_KEY=sobesnik
# S3_SECRET_KEY=sobesnik-secret
# S3_BUCKET=sobesnik-audio
# Где лежат модели whisper внутри контейнера (том asr-models)
# ASR_MODEL_DIR=/models
# Адрес API для бота и имя потока событий в Redis
# API_URL=http://api:8000/api/v1
# ANSWER_EVENTS_STREAM=sobesnik:answer-events
# Сколько ответов воркер оценивает одновременно: Ollama на Маке всё равно отвечает по одному
# WORKER_MAX_JOBS=1
# Сколько раз пробовать оценить ответ, если модель недоступна (паузы от 10 с до 2 минут);
# ответ сохранён и оценится, когда модель вернётся
# EVAL_MAX_TRIES=5
# Подробность логов: DEBUG | INFO | WARNING
# LOG_LEVEL=INFO
