# Скопировать в корень репозитория: cp deploy/.env.example .env
# Без .env compose стартует на этих же значениях по умолчанию.

# Postgres из compose
DATABASE_URL=postgresql+asyncpg://sobesnik:sobesnik@postgres:5432/sobesnik

# --- LLM ---------------------------------------------------------------------
# Провайдер: ollama | openai_compatible | fake
LLM_PROVIDER=ollama
# Ollama на хосте (Mac). На Linux с Ollama на хосте работает так же.
LLM_BASE_URL=http://host.docker.internal:11434
# Ключ нужен только для openai_compatible
LLM_API_KEY=
# Модель должна быть скачана: ollama pull qwen3.5:4b
LLM_MODEL=qwen3.5:4b
# Таймаут одного запроса к модели, секунды
LLM_TIMEOUT_S=120
# Размер контекста Ollama: вакансия на 20 000 символов не влезает в стандартный
LLM_NUM_CTX=16384
# Structured output для openai_compatible: json_schema | json_object
# (json_object — для endpoint'ов, которые не понимают json_schema)
LLM_STRUCTURED=json_schema
# Только для openai_compatible: none — выключить рассуждения модели (нужно для /v1 Ollama:
# иначе qwen3.5 рассуждает перед ответом, это медленно и обрезает JSON). Пусто — не отправлять.
LLM_REASONING_EFFORT=
# Сколько раз повторить запрос, если ответ модели не прошёл проверку
LLM_MAX_RETRIES=2

# Роли: gen — разбор вакансии и генерация вопросов, eval — оценка ответов.
# Пустое значение — берётся базовое LLM_* выше.
LLM_GEN_PROVIDER=
LLM_GEN_BASE_URL=
LLM_GEN_API_KEY=
LLM_GEN_MODEL=
LLM_EVAL_PROVIDER=
LLM_EVAL_BASE_URL=
LLM_EVAL_API_KEY=
LLM_EVAL_MODEL=

# Пример: всё через OpenAI-совместимый API самой Ollama
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_REASONING_EFFORT=none
#
# Пример: облачный OpenAI-совместимый endpoint
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=model-name

# --- Вакансия по ссылке -------------------------------------------------------
# Таймаут загрузки страницы, секунды
FETCH_TIMEOUT_S=10
# Разрешить ссылки на внутренние адреса (localhost, 10.x, 192.168.x) — только для экспериментов
FETCH_ALLOW_PRIVATE=false

LOG_LEVEL=INFO
